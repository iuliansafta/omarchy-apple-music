#!/usr/bin/env python3
"""Bridge between the Omarchy bar plugin and the dedicated Apple Music browser.

The Chromium extension (extension/chromium/duration-bridge.js) exposes
window.__omarchyAppleMusic = { collect, command } on music.apple.com. This
daemon, started by the QML service, relays both directions over Chromium's
DevTools protocol:

  - once per second it evaluates collect() and prints the result as one JSON
    line on stdout ({"ok": false} when no browser/page/bridge is available);
  - it polls COMMANDS_DIR for *.json command payloads, evaluates
    command(payload) in the page, and deletes the file after execution.

Usage: bridge-daemon PROFILE_DIR COMMANDS_DIR

Only the Python standard library is used; the WebSocket client is hand-rolled
(no CDP library ships with Python).
"""

import base64
import errno
import json
import os
import re
import socket
import stat
import struct
import sys
import time
import urllib.request

POLL_INTERVAL = 1.0
EVAL_TIMEOUT = 6.0
MAX_COMMAND_ATTEMPTS = 3

# Hard ceilings. The DevTools endpoint is only *expected* to be Chromium; a
# compromised or substituted localhost listener must not be able to drive
# unbounded allocation in this persistent process.
MAX_HANDSHAKE_BYTES = 16 * 1024      # HTTP 101 upgrade response
MAX_HTTP_BODY_BYTES = 512 * 1024     # /json/list response body
MAX_WS_MESSAGE_BYTES = 1024 * 1024   # one CDP message (frames + fragments)
MAX_COMMAND_BYTES = 64 * 1024        # one *.json command file
MAX_STATE_STRING = 512               # any string forwarded to the shell
MAX_UPNEXT_ENTRIES = 40

COMMAND_NAME = re.compile(r"^[A-Za-z0-9._-]+\.json$")
DESCRIPTOR_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
# The dedicated window is *expected* to sit on music.apple.com, but a
# prefix test would also accept music.apple.com.evil.test; the host must end
# at a delimiter.
PAGE_URL = re.compile(r"^https://music\.apple\.com(?:[/?#]|\Z)")


class ProtocolError(Exception):
    pass


class CdpClient:
    """Minimal CDP-over-WebSocket client for Runtime.evaluate."""

    def __init__(self, host, port, path):
        self._sock = socket.create_connection((host, port), timeout=5)
        self._sock.settimeout(5)
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        self._sock.sendall(request.encode())
        response = b""
        while b"\r\n\r\n" not in response:
            if len(response) > MAX_HANDSHAKE_BYTES:
                raise ProtocolError("handshake response too large")
            chunk = self._sock.recv(4096)
            if not chunk:
                raise ProtocolError("connection closed during handshake")
            response += chunk
        head, _, rest = response.partition(b"\r\n\r\n")
        status = head.split(b"\r\n")[0]
        if b" 101 " not in status:
            raise ProtocolError("websocket handshake rejected: " + status.decode("latin1"))
        # No permessage-deflate was offered, so frames arrive uncompressed.
        self._buf = rest
        self._next_id = 0

    def _read_exact(self, count, deadline):
        while len(self._buf) < count:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ProtocolError("timeout waiting for websocket data")
            self._sock.settimeout(min(remaining, 1.0))
            try:
                chunk = self._sock.recv(65536)
            except socket.timeout:
                continue
            except OSError as error:
                raise ProtocolError("socket error: " + str(error))
            if not chunk:
                raise ProtocolError("connection closed")
            self._buf += chunk
        out, self._buf = self._buf[:count], self._buf[count:]
        return out

    def _read_frame(self, deadline):
        first, second = self._read_exact(2, deadline)
        fin = bool(first & 0x80)
        opcode = first & 0x0F
        length = second & 0x7F
        if second & 0x80:
            raise ProtocolError("unexpectedly masked server frame")
        if length == 126:
            length = struct.unpack(">H", self._read_exact(2, deadline))[0]
        elif length == 127:
            length = struct.unpack(">Q", self._read_exact(8, deadline))[0]
        if length > MAX_WS_MESSAGE_BYTES:
            raise ProtocolError(f"frame too large: {length} bytes")
        payload = self._read_exact(length, deadline) if length else b""
        return fin, opcode, payload

    def _send_frame(self, opcode, payload=b""):
        mask = os.urandom(4)
        length = len(payload)
        if length < 126:
            header = struct.pack(">BB", 0x80 | opcode, 0x80 | length)
        elif length < 65536:
            header = struct.pack(">BBH", 0x80 | opcode, 0x80 | 126, length)
        else:
            header = struct.pack(">BBQ", 0x80 | opcode, 0x80 | 127, length)
        masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        self._sock.sendall(header + mask + masked)

    def _read_message(self, deadline):
        chunks = []
        total = 0
        while True:
            fin, opcode, payload = self._read_frame(deadline)
            if opcode == 9:  # ping
                self._send_frame(10, payload)
                continue
            if opcode == 8:
                raise ProtocolError("server sent close frame")
            if opcode in (1, 2):
                chunks = [payload]
                total = len(payload)
            elif opcode == 0 and chunks:
                chunks.append(payload)
                total += len(payload)
            else:
                continue
            if total > MAX_WS_MESSAGE_BYTES:
                raise ProtocolError("fragmented message too large")
            if fin:
                return b"".join(chunks)

    def call(self, method, params, timeout=EVAL_TIMEOUT):
        self._next_id += 1
        msg_id = self._next_id
        deadline = time.monotonic() + timeout
        message = json.dumps({"id": msg_id, "method": method, "params": params})
        self._send_frame(1, message.encode())
        while True:
            payload = self._read_message(deadline)
            try:
                parsed = json.loads(payload.decode())
            except (UnicodeDecodeError, json.JSONDecodeError):
                continue
            if parsed.get("id") != msg_id:
                continue  # stray event; our domains emit few, but stay safe
            if "error" in parsed:
                raise ProtocolError("CDP error: " + json.dumps(parsed["error"]))
            return parsed.get("result", {})

    def evaluate(self, expression, timeout=EVAL_TIMEOUT):
        result = self.call(
            "Runtime.evaluate",
            {"expression": expression, "awaitPromise": True, "returnByValue": True},
            timeout,
        )
        details = result.get("exceptionDetails")
        if details:
            raise ProtocolError("page exception: " + str(details.get("text", "")))
        return result.get("result", {}).get("value")

    def close(self):
        try:
            self._sock.close()
        except OSError:
            pass


def read_devtools_port(profile_dir):
    # Chromium writes the chosen port here when launched with
    # --remote-debugging-port=0.
    try:
        with open(os.path.join(profile_dir, "DevToolsActivePort")) as handle:
            port = int(handle.readline(16).strip() or 0)
            return port if 0 < port < 65536 else None
    except (OSError, ValueError):
        return None


def find_page_target(port):
    url = f"http://127.0.0.1:{port}/json/list"
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read(MAX_HTTP_BODY_BYTES + 1)
            if len(body) > MAX_HTTP_BODY_BYTES:
                return None
            targets = json.loads(body)
    except (OSError, ValueError):
        return None
    if not isinstance(targets, list):
        return None
    for target in targets:
        if not isinstance(target, dict):
            continue
        if target.get("type") == "page" and PAGE_URL.match(str(target.get("url", ""))):
            ws_url = target.get("webSocketDebuggerUrl")
            # Only ever dial back to loopback, no matter what the endpoint
            # claims.
            if isinstance(ws_url, str) and ws_url.startswith("ws://127.0.0.1:"):
                return ws_url
    return None


def connect(profile_dir):
    port = read_devtools_port(profile_dir)
    if not port:
        return None
    ws_url = find_page_target(port)
    if not ws_url:
        return None
    _, _, path = ws_url.partition("127.0.0.1:")
    slash = path.find("/")
    if slash < 0:
        return None
    try:
        return CdpClient("127.0.0.1", int(path[:slash]), path[slash:])
    except (OSError, ValueError, ProtocolError) as error:
        print("bridge-daemon: connect failed: " + str(error), file=sys.stderr, flush=True)
        return None


def open_private_dir(path):
    """Create and pin a self-owned 0700 directory without following any
    component symlinks. Traversal starts at the trusted root descriptor, and
    every missing component is created relative to its pinned parent."""
    if not os.path.isabs(path):
        raise OSError(errno.EINVAL, "path must be absolute")
    parts = path.split(os.sep)
    if not parts[-1] or any(not part or part in (".", "..") for part in parts[1:]):
        raise OSError(errno.EINVAL, "unsafe path component")

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    dirfds = []
    try:
        dirfds.append(os.open(os.sep, flags))
        for component in parts[1:]:
            try:
                nextfd = os.open(component, flags, dir_fd=dirfds[-1])
            except FileNotFoundError:
                try:
                    os.mkdir(component, 0o700, dir_fd=dirfds[-1])
                except FileExistsError:
                    pass
                nextfd = os.open(component, flags, dir_fd=dirfds[-1])
            dirfds.append(nextfd)

        info = os.fstat(dirfds[-1])
        if info.st_uid != os.geteuid():
            raise ProtocolError("commands dir owned by another user")
        if stat.S_IMODE(info.st_mode) != 0o700:
            os.fchmod(dirfds[-1], 0o700)
            info = os.fstat(dirfds[-1])
        if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ProtocolError("commands dir is not private")
    except (OSError, ProtocolError):
        for fd in reversed(dirfds):
            os.close(fd)
        raise

    for fd in reversed(dirfds[:-1]):
        os.close(fd)
    return dirfds[-1]


def read_command_file(dirfd, name):
    """Bounded no-follow read of one command file relative to the pinned
    directory fd. Raises ValueError/OSError on anything that is not a small,
    self-owned regular file containing one JSON object."""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("not a regular file")
        if info.st_uid != os.geteuid():
            raise ValueError("owned by another user")
        if info.st_size > MAX_COMMAND_BYTES:
            raise ValueError("command file too large")
        data = b""
        while len(data) <= MAX_COMMAND_BYTES:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) > MAX_COMMAND_BYTES:
            raise ValueError("command file too large")
    finally:
        os.close(fd)
    payload = json.loads(data.decode())
    if not isinstance(payload, dict):
        raise ValueError("command payload must be a JSON object")
    return payload


def consume_commands(client, commands_fd, attempts):
    try:
        names = sorted(n for n in os.listdir(commands_fd) if COMMAND_NAME.match(n))
    except OSError:
        return
    for name in names:
        try:
            payload = read_command_file(commands_fd, name)
        except (OSError, ValueError, json.JSONDecodeError, UnicodeDecodeError) as error:
            print(f"bridge-daemon: bad command {name}: {error}", file=sys.stderr, flush=True)
            try:
                os.unlink(name, dir_fd=commands_fd)
            except OSError:
                pass
            continue
        expression = "window.__omarchyAppleMusic ? window.__omarchyAppleMusic.command(" \
                     + json.dumps(payload) + ") : null"
        try:
            value = client.evaluate(expression)
        except ProtocolError:
            # Connection trouble: keep the file for a bounded number of
            # retries across reconnects.
            if note_command_failure(name, attempts):
                print(f"bridge-daemon: command dropped after retries: {name}", file=sys.stderr, flush=True)
                _drop(commands_fd, name)
            return  # the socket is probably dead; stop consuming this round
        attempts.pop(name, None)
        if isinstance(value, dict) and value.get("ok") is False:
            # The page understood the command but could not apply it (e.g. the
            # queue was still loading). Retry a bounded number of times.
            if note_command_failure(name, attempts):
                print(f"bridge-daemon: command dropped after retries: {name}", file=sys.stderr, flush=True)
                _drop(commands_fd, name)
            continue
        _drop(commands_fd, name)


def _drop(commands_fd, name):
    try:
        os.unlink(name, dir_fd=commands_fd)
    except OSError:
        pass
    print(f"bridge-daemon: command consumed: {name}", file=sys.stderr, flush=True)


def note_command_failure(name, attempts):
    """Record a failed attempt for a command; return True when it must be
    dropped. The counter is bounded, so a command is never retried forever,
    and the counter survives reconnects so a transient disconnect does not
    silently discard the pending command file."""
    count = attempts.get(name, 0) + 1
    if count >= MAX_COMMAND_ATTEMPTS:
        attempts.pop(name, None)
        return True
    attempts[name] = count
    return False


def _text(value, cap=MAX_STATE_STRING):
    return value[:cap] if isinstance(value, str) else ""


def _finite(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0
    return float(value) if -1e12 < value < 1e12 else 0


def sanitize_descriptor(value):
    if not isinstance(value, dict):
        return None
    ident = value.get("id")
    if not isinstance(ident, str) or not DESCRIPTOR_ID.match(ident):
        return None
    if "kind" in value and value.get("kind") != "song":
        return None
    descriptor = {"kind": "song", "id": ident}
    catalog = value.get("catalogId")
    if isinstance(catalog, str) and DESCRIPTOR_ID.match(catalog):
        descriptor["catalogId"] = catalog
    return descriptor


def sanitize_state(value):
    """Rebuild the collected page state from a fixed whitelist of typed,
    length-capped fields. Nothing the page (or a substituted DevTools
    endpoint) returns is forwarded to the shell verbatim."""
    if not isinstance(value, dict) or value.get("ok") is not True:
        return {"ok": False}
    state = {
        "ok": True,
        "trackTitle": _text(value.get("trackTitle")),
        "trackId": _text(value.get("trackId"), 128),
        "trackKind": _text(value.get("trackKind"), 32),
        "rating": _text(value.get("rating"), 16),
        "queuePosition": int(_finite(value.get("queuePosition"))),
        "queueLength": int(_finite(value.get("queueLength"))),
        "repeat": _text(value.get("repeat"), 16),
        "library": _text(value.get("library"), 32),
        "play": sanitize_descriptor(value.get("play")),
    }
    # Tri-state fields: forwarded only when definitely boolean, so the UI
    # keeps rendering "unknown" instead of a fabricated off.
    if isinstance(value.get("shuffle"), bool):
        state["shuffle"] = value["shuffle"]
    if isinstance(value.get("autoplay"), bool):
        state["autoplay"] = value["autoplay"]
    up_next = []
    items = value.get("upNext")
    if isinstance(items, list):
        for item in items[:MAX_UPNEXT_ENTRIES]:
            if not isinstance(item, dict):
                continue
            title = _text(item.get("title"))
            if not title:
                continue
            up_next.append({
                "index": int(_finite(item.get("index"))),
                "id": _text(item.get("id"), 128),
                "title": title,
                "artist": _text(item.get("artist")),
                "durationSeconds": _finite(item.get("durationSeconds")),
            })
    state["upNext"] = up_next
    return state


def close_client(client):
    """Close a CdpClient (if any) and return None so callers can clear their
    slot and rediscover a fresh port/page target on the next loop."""
    if client is not None:
        client.close()
    return None


def main():
    if len(sys.argv) != 3:
        print("Usage: bridge-daemon PROFILE_DIR COMMANDS_DIR", file=sys.stderr)
        return 2
    profile_dir, commands_dir = sys.argv[1], sys.argv[2]
    try:
        commands_fd = open_private_dir(commands_dir)
    except (OSError, ProtocolError) as error:
        print("bridge-daemon: unusable commands dir: " + str(error), file=sys.stderr, flush=True)
        return 1

    client = None
    attempts = {}
    while True:
        if client is None:
            client = connect(profile_dir)
        state = {"ok": False}
        if client is not None:
            try:
                value = client.evaluate(
                    "window.__omarchyAppleMusic ? window.__omarchyAppleMusic.collect() : null"
                )
                state = sanitize_state(value)
                consume_commands(client, commands_fd, attempts)
            except ProtocolError as error:
                # The socket or page target is gone (browser closed, page
                # replaced, WebSocket dropped). Drop the client so the next
                # loop rediscovers DevToolsActivePort and the Apple Music
                # page instead of reusing a known-dead socket. Pending
                # command files survive in the bounded retry state.
                print("bridge-daemon: session dropped: " + str(error), file=sys.stderr, flush=True)
                client = close_client(client)
                state = {"ok": False}
        try:
            print(json.dumps(state), flush=True)
        except BrokenPipeError:
            return 0  # the service stopped reading; exit quietly
        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    sys.exit(main())
