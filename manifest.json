{
  "schemaVersion": 1,
  "id": "iuliansafta.apple-music",
  "name": "Apple Music",
  "version": "0.3.1",
  "author": "Iulian Safta",
  "description": "Apple Music web player controls and now-playing information for the Omarchy bar.",
  "homepage": "https://github.com/iuliansafta/omarchy-apple-music",
  "license": "MIT",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "AppleMusicService.qml",
    "barWidget": "AppleMusicWidget.qml"
  },
  "barWidget": {
    "displayName": "Apple Music",
    "description": "Now playing and playback controls for Apple Music Web.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "barDisplay": "Artwork",
      "showArtist": true,
      "maxLabelWidth": 220,
      "showQueue": true,
      "showPlaybackModes": true,
      "showRecentlyPlayed": true
    },
    "schema": [
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "Bar display",
        "options": ["Artwork", "Text"],
        "defaultValue": "Artwork",
        "description": "Show a compact album-art button or the legacy Apple Music text label."
      },
      {
        "key": "showArtist",
        "type": "boolean",
        "label": "Show artist in Text mode",
        "defaultValue": true
      },
      {
        "key": "maxLabelWidth",
        "type": "integer",
        "label": "Text mode maximum width",
        "min": 100,
        "max": 500,
        "step": 20,
        "defaultValue": 220
      },
      {
        "key": "showQueue",
        "type": "boolean",
        "label": "Show up-next queue",
        "defaultValue": true
      },
      {
        "key": "showPlaybackModes",
        "type": "boolean",
        "label": "Show playback mode controls (shuffle, repeat, autoplay)",
        "defaultValue": true
      },
      {
        "key": "showRecentlyPlayed",
        "type": "boolean",
        "label": "Show recently played",
        "defaultValue": true
      }
    ]
  }
}
